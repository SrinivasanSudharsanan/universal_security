{
  "type": "index_parallel",
  "spec": {
    "ioConfig": {
      "type": "index_parallel",
      "inputSource": {
        "type": "local",
        "baseDir": "/home/srini/universal_security/data",
        "filter": "rls_test_data.csv"
      },
      "inputFormat": {
        "type": "csv",
        "findColumnsFromHeader": true,
        "skipHeaderRows": 1
      }
    },
    "tuningConfig": {
      "type": "index_parallel",
      "partitionsSpec": {
        "type": "dynamic"
      }
    },
    "dataSchema": {
      "dataSource": "employee_rls_data",
      "timestampSpec": {
        "column": "hire_date",
        "format": "yyyy-MM-dd"
      },
      "dimensionsSpec": {
        "dimensions": [
          "employee_id",
          "department",
          "access_level",
          "manager_id",
          "project_code"
        ]
      },
      "metricsSpec": [
        {
          "name": "count",
          "type": "count"
        },
        {
          "name": "salary",
          "type": "longSum",
          "fieldName": "salary"
        }
      ],
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "MONTH",
        "queryGranularity": "NONE",
        "rollup": false
      }
    }
  }
}
